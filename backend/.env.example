# Server Configuration
PORT=5000
NODE_ENV=development

# Razorpay Configuration (Optional - for production)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Email Configuration (Optional - for contact form notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Database Configuration (Optional - for production)
MONGODB_URI=mongodb://localhost:27017/resume-ready-stack
REDIS_URL=redis://localhost:6379
